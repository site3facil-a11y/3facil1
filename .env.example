# -------------------------------------------------------------
# Configurações do Ambiente e Servidor
# -------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://seudominio.com.br

# Lista de origens autorizadas para CORS separadas por vírgula
ALLOWED_ORIGINS=https://seudominio.com.br,https://admin.seudominio.com.br

# -------------------------------------------------------------
# Autenticação e Segurança (Obrigatórios)
# -------------------------------------------------------------
# JWT_SECRET deve ter no mínimo 32 caracteres criptograficamente aleatórios
JWT_SECRET=gere_uma_chave_secreta_com_mais_de_32_caracteres_aleatorios_aqui

# Credenciais iniciais do Administrador Master (criado/sincronizado no startup)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=SuaSenhaForteDeAdminAqui123!

# Habilita contas e dados de demonstração (deve ser false em produção)
SEED_DEMO=false

# Habilita auto-atualização do sistema via endpoint autenticado (padrão: false)
ENABLE_SELF_UPDATE=false

# -------------------------------------------------------------
# Banco de Dados PostgreSQL
# -------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/3facil_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario_postgres
DB_PASSWORD=sua_senha_postgres
DB_NAME=3facil_db

# -------------------------------------------------------------
# E-mail Transacional / SMTP (Opcional)
# -------------------------------------------------------------
SMTP_HOST=smtp.provedor.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_FROM="3Fácil Plataforma <noreply@seudominio.com.br>"
SMTP_REPLY_TO=suporte@seudominio.com.br
SMTP_SECURE=false

# -------------------------------------------------------------
# Integrações de IA (Opcional)
# -------------------------------------------------------------
GEMINI_API_KEY=
